<!doctype html>
<html lang="nl">
<title>BVFD</title>

<main>
<style>
/* sectionclass van de jouw-suggestie page */
form.form {
    display: flex;
    width: fit-content;
    flex-direction: column;
    justify-self: center;
    gap: 0.5em;

    input {
        width: 250px;
        padding: 0.5em;
        border: solid 0.1em lightslategray;
        border-radius: 5em;
        border-style: default;
        align-self: center;
    }

    label {
        align-self: start center;
    }

    input.button {
        width: 100px;
        justify-self: end center;
        border: none;
    }
}
</style>

<a href="/suggesties" class="terug knop"><img src="../imgs/undo.svg" alt="terug"></a>

<form action="/jouw-suggestie" method="POST" class="form">
    <label for="plant">Welke plant zou jij willen zien in de tuin?</label>
    <input id="plant" name="suggestion" type="text" placeholder="plant..." alt="suggestie textveld" required>

    <label for="reden">Waarom zou je dit willen zien?</label>
    <input id="reden" name="suggestion_reason" type="text" placeholder="waarom?..." alt="reden textveld" required>
  
    <input class="button verstuur" type="submit" value="verstuur" alt="verstuurknop">
</form>

</main>


